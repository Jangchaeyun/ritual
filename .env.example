# 값 없이 이름만 둡니다. 실제 비밀은 .env.local에 넣고 저장소에 올리지 않습니다.

# Supabase 프로젝트 URL과 anon(공개) 키. 서비스 롤 키는 브라우저에 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth. 로컬에서는 http://localhost:3000 을 사용합니다.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Calendar 연동. 승인된 리디렉션 URI는 /api/auth/callback/google 입니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 오늘의 리포트. 없으면 리포트 생성만 거절하고 나머지 화면은 동작합니다.
GOOGLE_GENERATIVE_AI_API_KEY=
